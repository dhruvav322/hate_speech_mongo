# HATE SPEECH MODERATION SYSTEM - Environment Configuration
# Copy to .env and fill in your values

# SECURITY (REQUIRED)
API_KEY=generate-with-secrets-token-urlsafe-32
MONGO_ROOT_PASSWORD=change-this-strong-password

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# ENVIRONMENT
ENVIRONMENT=production
LOG_LEVEL=INFO

# DATABASE
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hate_speech_mitigation
MONGO_ROOT_USER=admin

# API
API_HOST=0.0.0.0
API_PORT=8000

# MODELS
DETOXIFY_MODEL=multilingual
